# Docker Compose project name.
COMPOSE_PROJECT_NAME=dsriker

# Shared simulation image name built from docker/Dockerfile.
SIM_IMAGE=dsriker-sim:dev

# ROS 2 domain used inside containers.
ROS_DOMAIN_ID=42

# Pinned full ArduPilot commit SHA for Copter SITL.
ARDUPILOT_REF=92b0cd788ec29406f26c6f9c31d5ceedbd1cc538

# Scenario and model selection.
SCENARIO=default

# MuJoCo camera stream defaults.
CAMERA_ENABLED=true
CAMERA_NAME=front_cam
CAMERA_FRAME=front_cam
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=10
CAMERA_TOPIC=/sim/camera/front/image_raw
CAMERA_INFO_TOPIC=/sim/camera/front/camera_info

# Browser visualization port for the local noVNC RViz2 desktop.
NOVNC_PORT=6080

# Force software OpenGL for container-side rendering and RViz2.
LIBGL_ALWAYS_SOFTWARE=1

# Optional resource hints for later Compose tuning.
SIM_CPU_LIMIT=4
SIM_MEMORY_LIMIT=8g
